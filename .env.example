# Taller Isidro - Variables de entorno (Plantilla)
# Copiar este archivo a .env y reemplazar los valores con los correspondientes reales

# Webhook URLs de n8n
VITE_CHAT_WEBHOOK_URL=https://tallerisidro-n8n.ejemplo.host/webhook/tu-webhook-chat-id/chat
VITE_DATA_WEBHOOK_URL=https://tallerisidro-n8n.ejemplo.host/webhook/tu-webhook-data-id

# API Key para autenticar requests (opcional si se usa)
VITE_API_KEY=tu-api-key-segura
